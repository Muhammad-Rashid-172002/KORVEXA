{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

# Which slot (blue/green) is live is written by scripts/deploy.sh into these two snippets.
import /etc/caddy/active/*.caddy

(security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(self)"
		-Server
	}
}

# Apex serves the site; www redirects to it.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	import security
	import web_upstream
}

# API + Socket.io (WebSocket upgrades are proxied automatically).
api.{$DOMAIN} {
	import security
	import api_upstream
}

{
  "name": "@glasswork/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@glasswork/emails": "workspace:*",
    "@glasswork/shared": "workspace:*",
    "@sentry/node": "10.76.2",
    "bullmq": "6.3.12",
    "nodemailer": "9.1.1",
    "pino": "10.4.0",
    "resend": "6.32.1"
  },
  "devDependencies": {
    "@glasswork/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

{
  "name": "@glasswork/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.mts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "openapi": "node dist/openapi.js && pnpm --filter @glasswork/shared gen:client"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@glasswork/db": "workspace:*",
    "@glasswork/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@sentry/nestjs": "10.76.2",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.7",
    "bullmq": "6.3.12",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-adapter": "2.5.8",
    "stripe": "22.6.2",
    "uuidv7": "1.2.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@glasswork/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "eslint": "10.12.0",
    "pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "files": [
    "dist"
  ]
}

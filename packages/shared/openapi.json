  "info": {
    "title": "Glasswork API",
    "description": "Glasswork by KorvenzaTech REST API. Auth endpoints live under /v1/auth (Better Auth; reference at /v1/auth/reference in dev).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gw.session_token"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "buyer",
                "seller",
                "admin",
                "support"
              ]
            }
          },
          "adminScopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "product",
                "growth",
                "operations"
              ]
            }
          },
          "activeMode": {
            "type": "string",
            "enum": [
              "buyer",
              "seller"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "emailVerified",
          "roles",
          "adminScopes",
          "activeMode",
          "displayName"
        ]
      },
      "PublicConfigDto": {
        "type": "object",
        "properties": {
          "productName": {
            "type": "string"
          },
          "oauth": {
            "type": "object",
            "properties": {
              "google": {
                "type": "boolean"
              },
              "github": {
                "type": "boolean"
              }
            },
            "required": [
              "google",
              "github"
            ]
          }
        },
        "required": [
          "productName",
          "oauth"
        ]

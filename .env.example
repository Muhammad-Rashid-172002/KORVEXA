# ─────────────────────────────────────────────────────────────────────────────
# Glasswork — environment variables
# Copy to .env (`cp .env.example .env`). Never commit .env. Values below work for
# local development with `pnpm dev:up` / `pnpm dev`. Production values: see SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── URLs & ports ─────────────────────────────────────────────────────────────
# Public URL of the web app (browser-facing). Used for CORS and auth redirects.
WEB_URL=http://localhost:3000
# Public URL of the API (browser-facing). Used in verification links and OAuth callbacks.
API_PUBLIC_URL=http://localhost:4000
API_PORT=4000
WORKER_HEALTH_PORT=4001
# Extra allowed CORS origins, comma separated (optional).
CORS_ORIGINS=
# Parent domain for auth cookies when web and API are on different subdomains in prod, e.g. .glasswork.app
COOKIE_DOMAIN=
# true when running behind Caddy/another reverse proxy (client IP from X-Forwarded-For).
TRUST_PROXY=false
# Serve Swagger UI at /v1/docs (dev only).
API_DOCS_ENABLED=true

# ── Web (Next.js) ────────────────────────────────────────────────────────────
# Browser → API base URL (baked into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side (SSR) → API base URL. In Docker this is the internal service name.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=glasswork
POSTGRES_PASSWORD=glasswork
POSTGRES_DB=glasswork
POSTGRES_PORT=5432
DATABASE_URL=postgres://glasswork:glasswork@localhost:5432/glasswork

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# REQUIRED. ≥32 random chars. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghij
AUTH_RATE_LIMIT_ENABLED=true
# Max sign-in / sign-up attempts per IP per minute.
AUTH_RATE_LIMIT_MAX=10
# OAuth (optional — buttons are hidden until both values are set). See SETUP.md → "OAuth apps".
# Google callback: {API_PUBLIC_URL}/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: {API_PUBLIC_URL}/v1/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Object storage (RustFS locally, Cloudflare R2 in prod) ───────────────────
# Endpoint the API uses to talk to storage (in Docker compose this is overridden to http://rustfs:9000).
S3_ENDPOINT=http://localhost:9000
# Endpoint the BROWSER uses for presigned URLs.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=glasswork-dev
S3_ACCESS_KEY_ID=glasswork
S3_SECRET_ACCESS_KEY=glasswork-dev-secret
S3_FORCE_PATH_STYLE=true
# Create the bucket on API boot if missing (dev only).
S3_AUTO_CREATE_BUCKET=true
# Host ports for local RustFS: S3 API and web console (http://localhost:9001, log in with the S3 keys above).
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Override the storage image only if the pinned one can't be pulled.
STORAGE_IMAGE=rustfs/rustfs:1.0.1

# ── Email ────────────────────────────────────────────────────────────────────
# From address (use a verified domain in prod).
EMAIL_FROM="Glasswork <no-reply@glasswork.local>"
# Local: Mailpit SMTP (UI at http://localhost:8025). In Docker the worker uses host "mailpit".
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Prod: Resend API key. When set, Resend is used instead of SMTP.
RESEND_API_KEY=

# ── Payments (TEST MODE ONLY until the legal entity is decided — DECISIONS D-020) ──
# 'test' = built-in simulated provider (no network, no Stripe account needed). 'stripe' = Stripe test mode.
PAYMENTS_PROVIDER=test
# Stripe TEST keys (sk_test_…). Live keys (sk_live_…) are refused unless PAYMENTS_LIVE_ENABLED=true.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from `stripe listen` or the dashboard endpoint → {API_PUBLIC_URL}/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
PAYMENTS_LIVE_ENABLED=false
# HMAC secret for the simulated provider's signed webhooks (dev/CI only; the provider is refused in production).
TEST_PAYMENTS_WEBHOOK_SECRET=dev-only-test-payments-secret
# Shared secret between worker and API for internal timers (auto-approve). Min 24 chars; REQUIRED to change in production.
INTERNAL_API_TOKEN=dev-only-internal-token-change-me-0123456789

# ── Files, push ──────────────────────────────────────────────────────────────
# 'off' = uploads are downloadable immediately (dev only; production refuses it). 'clamav' = scan via the worker + clamd.
SCAN_MODE=off

# --- AI (Phase 6) ---
# stub = deterministic offline answers (dev/CI); anthropic = Claude API (needs the key); off = disable AI features
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Optional per-feature overrides (empty = AI_MODEL), e.g. AI_MODEL_BRIEF_BUILDER=claude-opus-5-5
AI_MODEL_BRIEF_BUILDER=
AI_MODEL_MATCHING=
AI_MODEL_PROGRESS_REPORT=
AI_MODEL_MEETING_NOTES=
AI_EFFORT=medium
# Hard spend caps in US cents per user and for the whole platform per UTC day
AI_DAILY_USER_CAP_CENTS=100
AI_DAILY_GLOBAL_CAP_CENTS=2000
AI_RATE_LIMIT_PER_HOUR=30

# --- Meetings and code activity (Phase 7) ---
# stub = no real video (dev); daily = Daily.co (needs the two keys); off = hide meetings
VIDEO_PROVIDER=stub
DAILY_API_KEY=
DAILY_DOMAIN=
# Secret shared with the GitHub App / webhook that posts to /v1/webhooks/github
GITHUB_WEBHOOK_SECRET=dev-only-github-webhook-secret
# Web push (optional). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@localhost

# ── General rate limit ───────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300

# ── Observability (optional — disabled when empty) ───────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
